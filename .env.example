NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_key_here
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_key_here

# Optional: an Alchemy key for server routes (/api/rift/holdings). The NEXT_PUBLIC key above is limited to
# the site's own domain by its Alchemy allowlist, so servers cannot use it; without this, they use public RPCs.
ALCHEMY_SERVER_KEY=
