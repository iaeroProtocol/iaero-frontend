{
  "name": "iaero-saero-local-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "serve:staged-production": "node server/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "test:browser:live": "node scripts/live-browser-check.mjs",
    "test:browser:deposit": "node scripts/deposit-browser-check.mjs",
    "test:deposit:fork": "node scripts/deposit-fork-check.mjs",
    "test:deposit:worker-read": "node scripts/deposit-worker-read-check.mjs",
    "test:read-only": "node scripts/read-only-check.mjs",
    "test:browser:sweep": "node scripts/sweep-browser-check.mjs",
    "test:sweep:read-only": "node scripts/sweep-read-only-check.mjs",
    "test:batch:read-only": "node scripts/batch-read-only-check.mjs",
    "test:markets:read-only": "node scripts/market-read-only-check.mjs",
    "test:usability": "node scripts/usability-check.mjs",
    "test:browser:yield": "node scripts/yield-browser-check.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "pages:build": "node scripts/build-pages.mjs --cloudflare",
    "test:rift": "node --test test/restored-rift/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.10",
    "@walletconnect/ethereum-provider": "2.26.0",
    "clsx": "2.1.1",
    "lucide-react": "0.542.0",
    "qrcode.react": "4.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "viem": "2.57.11",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "miniflare": "4.20260730.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "undici": "8.12.3",
    "sharp": "0.35.5",
    "ws": "8.22.0",
    "decode-uri-component": "0.5.1",
    "zod": "4.6.7"
  }
}
